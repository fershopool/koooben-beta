PORT=8787
APPLE_PASS_TYPE_IDENTIFIER=pass.com.kooben.consentidos
APPLE_TEAM_IDENTIFIER=ABCDEFGHIJ
APPLE_WEB_SERVICE_URL=https://api.example.com
WALLET_SIGNING_SECRET=cambia-esto-por-un-secreto-largo
WALLET_ADMIN_TOKEN=cambia-esto-por-otro-secreto

# Opción A: certificado exportado como .p12 en Base64.
APPLE_CERTIFICATE_P12_BASE64=
APPLE_CERTIFICATE_PASSWORD=

# Opción B: rutas locales al certificado .p12 y al certificado WWDR de Apple.
APPLE_CERTIFICATE_P12_PATH=
APPLE_WWDR_CERTIFICATE_PATH=

# Opción C: PEM directo para el certificado y la llave privada.
APPLE_CERTIFICATE_PEM=
APPLE_PRIVATE_KEY_PEM=
APPLE_WWDR_CERTIFICATE_PEM=
